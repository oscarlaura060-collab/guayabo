# Supabase — copia este archivo a .env.local y completa los valores.
# La service_role NO va aquí (solo en el script de migración, fuera del repo).
NEXT_PUBLIC_SUPABASE_URL=https://qoxqqkuzhlafhmevqfeb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# (Opcional) Prefijo del panel administrativo — "ruta no predecible".
# Vacío = el panel vive en las rutas normales (/dashboard, /login, …).
# Con un valor (ej. /panel-a3f9c1) el panel y el login SOLO existen bajo ese
# prefijo; las rutas desnudas responden 404 a quien no tiene sesión.
# Es una capa extra: la seguridad real es autenticación + RLS.
# NEXT_PUBLIC_ADMIN_PATH=/panel-a3f9c1
