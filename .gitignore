# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# Claves PÚBLICAS de Supabase (anon/publishable, protegidas por RLS): seguras en el repo.
# La service_role y RESEND_API_KEY NO van aquí; se configuran como secretos en Vercel.
!.env.production

# archivos subidos por el usuario (contexto de la migración, no van al repo)
/uploads


# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
